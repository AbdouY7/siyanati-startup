generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String               @id @default(uuid())
  email                 String               @unique
  password_hash         String
  role                  UserRole             @default(customer)
  is_active             Boolean              @default(true)
  email_verified        Boolean              @default(false)
  created_at            DateTime             @default(now())
  updated_at            DateTime             @updatedAt
  refresh_token         String?
  phone                 String?              @unique
  customer_appointments Appointment[]        @relation("CustomerAppointments")
  client_profile        ClientProfile?
  diagnostic_comments   DiagnosticComment[]
  diagnostic_posts      DiagnosticPost[]
  diagnostic_reactions  DiagnosticReaction[]
  diagnostic_saves      DiagnosticSave[]
  orders_as_customer    Order[]              @relation("CustomerOrders")
  payments              Payment[]            @relation("UserPayments")
  professional_profile  ProfessionalProfile?
  authored_reports      Report[]             @relation("AuthoredReports")
  authored_reviews      Review[]             @relation("AuthoredReviews")
  store_profile         StoreProfile?
  vehicles              Vehicle[]
  notifications         Notification[]       @relation("UserNotifications")

  favorites Favorite[]

  // Chat System
  conversations_as_participant_one Conversation[] @relation("ParticipantOne")
  conversations_as_participant_two Conversation[] @relation("ParticipantTwo")
  sent_messages                    Message[]      @relation("SentMessages")

  // Verification fields
  phone_verified        Boolean              @default(false)
  
  // Email OTP fields
  email_otp_hash        String?
  email_otp_expires_at  DateTime?
  email_otp_last_sent_at DateTime?
  email_otp_attempts    Int                  @default(0)

  // Phone OTP fields
  phone_otp_hash        String?
  phone_otp_expires_at  DateTime?
  phone_otp_last_sent_at DateTime?
  phone_otp_attempts    Int                  @default(0)

  // Legacy token fields (to be replaced, kept for migration safety if needed, but best to remove if not used elsewhere)
  email_verification_token      String?
  email_verification_expires_at DateTime?
  phone_verification_code       String?
  phone_verification_expires_at DateTime?
  reset_password_token          String?
  reset_password_expires_at     DateTime?

  @@index([role, created_at])  // Dashboard: count by role, trend by date
  @@map("users")
}

model Favorite {
  id          String        @id @default(uuid())
  user_id     String
  target_id   String        // ID of store/professional/part
  target_type FavoriteTarget
  created_at  DateTime      @default(now())
  user        User          @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, target_id, target_type])
  @@index([user_id, target_type])
  @@index([target_id, target_type])
  @@map("favorites")
}

model ClientProfile {
  id                 String    @id @default(uuid())
  user_id            String    @unique
  full_name          String
  profilePicUrl      String?
  wilaya             String?
  address            String?
  date_of_birth      DateTime?
  national_id_number String?
  national_id_card   String[]
  avatar_url         String?
  preferred_language String    @default("ar")
  created_at         DateTime  @default(now())
  user               User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  payment_accounts    PaymentAccount[]
  @@map("client_profiles")
}

model StoreProfile {
  id                   String        @id @default(uuid())
  user_id              String        @unique
  owner_name           String
  store_name           String
  description          String?
  address              String
  wilaya               String
  location_coordinates String?
  documents            String[]
  images               String[]
  logo_url             String?
  status               ProfileStatus @default(pending)
  rejection_reason     String?
  reviewed_by_admin_id String?
  reviewed_at          DateTime?
  submitted_at         DateTime      @default(now())
  is_frozen            Boolean       @default(false)
  rating_avg           Decimal       @default(0) @db.Decimal(3, 2)
  rating_count         Int           @default(0)
  dahabia_rip          String?
  created_at           DateTime      @default(now())
  orders               Order[]       @relation("StoreOrders")
  user                 User          @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([created_at])         // Dashboard: recent stores, trend
  @@index([status, created_at])  // Dashboard: filter by status
  @@map("store_profiles")
}

model ProfessionalProfile {
  id                   String                          @id @default(uuid())
  user_id              String                          @unique
  specialty_type       String
  experience_years     Int?
  wilaya               String
  location_address     String?
  documents            String[]
  bio                  String?
  status               ProfileStatus                   @default(pending)
  // new professional store table add and there relations 
  
work_type   WorkType   @default(individuel)  // new enum

  rejection_reason     String?
  reviewed_by_admin_id String?
  reviewed_at          DateTime?
  submitted_at         DateTime                        @default(now())
  is_available         Boolean                         @default(true)
  is_frozen            Boolean                         @default(false)
  hourly_rate_dzd      Decimal?                        @db.Decimal(12, 2)
  rating_avg           Decimal                         @default(0) @db.Decimal(3, 2)
  rating_count         Int                             @default(0)
  subscription_id      String?
  dahabia_rip          String?
  created_at           DateTime                        @default(now())
  full_name            String
  avatar_url           String?
  appointments         Appointment[]                   @relation("ProfessionalAppointments")
  user                 User                            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  ProfessionalStore               ProfessionalStore?           @relation("ProfessionalStoreRelation")
  schedule_exceptions  ProfessionalScheduleException[]
  schedules            ProfessionalSchedule[]

  @@index([created_at])         // Dashboard: recent pros, trend
  @@index([status, created_at])  // Dashboard: filter by status
  @@map("professional_profiles")
}

model ProfessionalStore {
  id               String          @id @default(uuid())
  professional_id  String          @unique  // one-to-one: a pro owns one store
  name             String
  wilaya           String
  address          String
  location_coordinates String?
  images           String[]
  documents        String[]
  logo_url         String?
  status           ProfileStatus   @default(pending)
  created_at       DateTime        @default(now())

  professional     ProfessionalProfile @relation("ProfessionalStoreRelation" , fields: [professional_id], references: [id], onDelete: Cascade)

  @@map("stores")
}

enum WorkType {
  individuel
  avec_magasin
}

model Brand {
  id                   String              @id @default(uuid())
  name                 String              @unique
  country              String?
  logo_url             String?
  is_deleted           Boolean             @default(false)
  diagnostic_posts     DiagnosticPost[]
  models               Model[]
  part_compatibilities PartCompatibility[]
  vehicles             Vehicle[]

  @@map("brands")
}

model Model {
  id                   String              @id @default(uuid())
  brand_id             String
  name                 String
  year_start           Int?
  year_end             Int?
  diagnostic_posts     DiagnosticPost[]
  brand                Brand               @relation(fields: [brand_id], references: [id], onDelete: Cascade)
  part_compatibilities PartCompatibility[]
  vehicles             Vehicle[]

  @@map("models")
}

model Vehicle {
  id                        String           @id @default(uuid())
  user_id                   String
  brand_id                  String
  model_id                  String
  year                      Int
  vehicule_picture_url           String?
  fuel_type                 FuelType?
  health_status             Int? // in percent 0-100
  engine_cc                 Int?
  registration_number       String?
  registration_document_url String?
  vin                       String?          @unique
  is_default                Boolean          @default(false)
  created_at                DateTime         @default(now())
  color                     String?
  mileage_km                Int?
  notes                     String?
  appointments              Appointment[]
  diagnostic_posts          DiagnosticPost[]
  brand                     Brand            @relation(fields: [brand_id], references: [id])
  model                     Model            @relation(fields: [model_id], references: [id])
  user                      User             @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("vehicles")
}

model Category {
  id        String     @id @default(uuid())
  parent_id String?
  name      String     
  slug      String
  icon_url  String?
  parent    Category?  @relation("CategoryTree", fields: [parent_id], references: [id])
  children  Category[] @relation("CategoryTree")
  parts     Part[]

@@unique([name, parent_id])
  @@map("categories")
}

model Part {
  id                   String              @id @default(uuid())
  seller_id            String
  seller_type          SellerType
  category_id          String?
  name                 String
  description          String?
  sku                  String?
  oem_reference        String?
  condition            PartCondition       @default(new)
  price_dzd            Decimal             @db.Decimal(12, 2)
  stock_qty            Int                 @default(1)
  weight_kg            Decimal?            @db.Decimal(6, 2)
  images               String[]
  is_active            Boolean             @default(true)
  is_featured          Boolean             @default(false)
  is_verified          Boolean             @default(false)
  verified_at          DateTime?
  verified_by_admin_id String?
  views_count          Int                 @default(0)
  created_at           DateTime            @default(now())
  updated_at           DateTime            @updatedAt
  order_items          OrderItem[]
  compatibilities      PartCompatibility[]
  category             Category?           @relation(fields: [category_id], references: [id])

  @@unique([seller_id, sku])
  @@index([seller_id, seller_type])
  @@index([category_id])
  @@index([condition, price_dzd])
  @@index([is_verified, is_active])
  @@index([created_at])           // Dashboard: trend by date
  @@map("parts")
}

model PartCompatibility {
  id             String  @id @default(uuid())
  part_id        String
  brand_id       String
  model_id       String
  year_from      Int
  year_to        Int?
  engine_variant String?
  brand          Brand   @relation(fields: [brand_id], references: [id])
  model          Model   @relation(fields: [model_id], references: [id])
  part           Part    @relation(fields: [part_id], references: [id], onDelete: Cascade)

  @@index([part_id])
  @@index([brand_id, model_id, year_from])
  @@map("part_compatibility")
}

model Order {
  id                    String            @id @default(uuid())
  customer_id           String
  store_id              String
  order_number          String            @unique
  status                OrderStatus       @default(pending)
  subtotal_dzd          Decimal           @db.Decimal(12, 2)
  discount_dzd          Decimal           @default(0) @db.Decimal(10, 2)
  total_dzd             Decimal           @db.Decimal(12, 2)
  delivery_type         OrderDeliveryType
  delivery_address      String?
  delivery_notes        String?
  notes                 String?
  loyalty_points_used   Int               @default(0)
  loyalty_points_earned Int               @default(0)
  cancelled_at          DateTime?
  cancellation_reason   String?
  created_at            DateTime          @default(now())
  updated_at            DateTime          @updatedAt
  items                 OrderItem[]
  customer              User              @relation("CustomerOrders", fields: [customer_id], references: [id])
  store                 StoreProfile      @relation("StoreOrders", fields: [store_id], references: [id])
  payment               Payment?
  reviews               Review[]

  @@index([customer_id, status])
  @@index([store_id, status])
  @@index([created_at])
  @@map("orders")
}

model OrderItem {
  id             String  @id @default(uuid())
  order_id       String
  part_id        String
  part_name      String
  part_sku       String?
  quantity       Int
  unit_price_dzd Decimal @db.Decimal(12, 2)
  discount_pct   Decimal @default(0) @db.Decimal(5, 2)
  line_total_dzd Decimal @db.Decimal(12, 2)
  order          Order   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  part           Part    @relation(fields: [part_id], references: [id])

  @@index([order_id])
  @@index([part_id])
  @@map("order_items")
}

model Payment {
  id               String        @id @default(uuid())
  order_id         String?       @unique
  payer_id         String
  method           PaymentMethod
  amount_dzd       Decimal       @db.Decimal(12, 2)
  status           PaymentStatus @default(pending)
  edahabia_ref     String?       @unique
  gateway_response Json?
  failed_reason    String?
  paid_at          DateTime?
  created_at       DateTime      @default(now())
  subscription_id  String?       @unique
  appointment_id   String?       @unique
  order            Order?        @relation(fields: [order_id], references: [id], onDelete: Cascade)
  appointment      Appointment?  @relation(fields: [appointment_id], references: [id], onDelete: Cascade)
  payer            User          @relation("UserPayments", fields: [payer_id], references: [id])
  subscription     Subscription? @relation(fields: [subscription_id], references: [id])

  @@index([order_id, status])
  @@index([subscription_id])
  @@index([payer_id])
  @@map("payments")
}

model PaymentAccount {
  id            String   @id @default(uuid())
  client_id     String
  account_name  String   @default("Compte CCP")
  ccp_code      String
  ccp_key       String
  full_name     String
  is_default    Boolean  @default(false)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  client ClientProfile @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@unique([client_id, ccp_code])
  @@index([client_id, is_active])
  @@map("payment_accounts")
}

model ProfessionalSchedule {
  id                    String              @id @default(uuid())
  professional_id       String
  day_of_week           Int
  start_time            String
  end_time              String
  slot_duration_minutes Int                 @default(60)
  is_active             Boolean             @default(true)
  professional          ProfessionalProfile @relation(fields: [professional_id], references: [id], onDelete: Cascade)

  @@index([professional_id, day_of_week])
  @@map("professional_schedules")
}

model ProfessionalScheduleException {
  id              String              @id @default(uuid())
  professional_id String
  exception_date  DateTime            @db.Date
  is_day_off      Boolean             @default(true)
  start_time      String?
  end_time        String?
  reason          String?
  professional    ProfessionalProfile @relation(fields: [professional_id], references: [id], onDelete: Cascade)

  @@index([professional_id, exception_date])
  @@map("professional_schedule_exceptions")
}

model Appointment {
  id                   String              @id @default(uuid())
  customer_id          String
  professional_id      String
  vehicle_id           String?
  service_type         String
  description          String?
  location_address     String?
  scheduled_at         DateTime?
  duration_minutes     Int?
  quoted_price_dzd     Decimal?            @db.Decimal(12, 2)
  confirmation_note    String?
  final_price_dzd      Decimal?            @db.Decimal(12, 2)
  payment_collected    Boolean             @default(false)
  payment_collected_at DateTime?
  completion_notes     String?
  completed_at         DateTime?
  cancelled_by         String?
  cancellation_reason  String?
  cancelled_at         DateTime?
  status               AppointmentStatus   @default(pending)
  created_at           DateTime            @default(now())
  updated_at           DateTime            @updatedAt
  customer             User                @relation("CustomerAppointments", fields: [customer_id], references: [id], onDelete: Cascade)
  professional         ProfessionalProfile @relation("ProfessionalAppointments", fields: [professional_id], references: [id])
  vehicle              Vehicle?            @relation(fields: [vehicle_id], references: [id])
  reviews              Review[]
  payment              Payment?

  @@index([customer_id, status])
  @@index([professional_id, scheduled_at])
  @@map("appointments")
}

model Review {
  id             String       @id @default(uuid())
  author_id      String
  target_id      String
  target_type    ReviewTarget
  order_id       String?
  appointment_id String?
  rating         Int
  comment        String?
  is_verified    Boolean      @default(false)
  helpful_count  Int          @default(0)
  media_urls     String[]
  created_at     DateTime     @default(now())
  appointment    Appointment? @relation(fields: [appointment_id], references: [id])
  author         User         @relation("AuthoredReviews", fields: [author_id], references: [id], onDelete: Cascade)
  order          Order?       @relation(fields: [order_id], references: [id])

  // Constraint removed to allow multiple reviews per store (one per order/appointment)
  @@index([author_id])
  @@index([target_type, target_id])
  @@map("reviews")
}

model Report {
  id                   String       @id @default(uuid())
  reporter_id          String
  target_id            String
  target_type          ReportTarget
  reason               ReportReason
  description          String?
  status               ReportStatus @default(pending)
  reviewed_by_admin_id String?
  conversation_id      String?
  conversation         Conversation? @relation(fields: [conversation_id], references: [id])
  admin_notes          String?
  reviewed_at          DateTime?
  created_at           DateTime     @default(now())
  reporter             User         @relation("AuthoredReports", fields: [reporter_id], references: [id], onDelete: Cascade)

  @@index([reporter_id])
  @@index([target_type, target_id])
  @@index([status, created_at])
  @@map("reports")
}

model Notification {
  id           String           @id @default(uuid())
  user_id      String
  type         NotificationType
  title        String
  message      String
  reference_id String?
  is_read      Boolean          @default(false)
  created_at   DateTime         @default(now())
  user         User             @relation("UserNotifications", fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_read])
  @@index([created_at])
  @@map("notifications")
}

model DiagnosticPost {
  id                  String               @id @default(uuid())
  author_id           String
  vehicle_id          String?
  title               String               @db.VarChar(200)
  description         String
  images              String[]
  brand_id            String?
  model_id            String?
  year                Int?
  fuel_type           FuelType?
  status              PostStatus           @default(open)
  views_count         Int                  @default(0)
  saves_count         Int                  @default(0)
  is_deleted          Boolean              @default(false)
  deleted_by_admin_id String?
  deleted_at          DateTime?
  created_at          DateTime             @default(now())
  updated_at          DateTime             @updatedAt
  comments            DiagnosticComment[]
  author              User                 @relation(fields: [author_id], references: [id], onDelete: Cascade)
  brand               Brand?               @relation(fields: [brand_id], references: [id])
  model               Model?               @relation(fields: [model_id], references: [id])
  vehicle             Vehicle?             @relation(fields: [vehicle_id], references: [id])
  reactions           DiagnosticReaction[]
  saves               DiagnosticSave[]

  @@index([author_id])
  @@index([brand_id, model_id])
  @@index([status])
  @@index([created_at])
  @@map("diagnostic_posts")
}

model DiagnosticComment {
  id                 String               @id @default(uuid())
  post_id            String
  author_id          String
  parent_id          String?
  body               String
  images             String[]
  is_accepted_answer Boolean              @default(false)
  is_deleted         Boolean              @default(false)
  created_at         DateTime             @default(now())
  updated_at         DateTime             @updatedAt
  author             User                 @relation(fields: [author_id], references: [id], onDelete: Cascade)
  parent             DiagnosticComment?   @relation("CommentReplies", fields: [parent_id], references: [id])
  replies            DiagnosticComment[]  @relation("CommentReplies")
  post               DiagnosticPost       @relation(fields: [post_id], references: [id], onDelete: Cascade)
  reactions          DiagnosticReaction[]

  @@index([post_id, parent_id])
  @@index([author_id])
  @@map("diagnostic_comments")
}

model DiagnosticSave {
  id         String         @id @default(uuid())
  user_id    String
  post_id    String
  created_at DateTime       @default(now())
  post       DiagnosticPost @relation(fields: [post_id], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, post_id])
  @@index([post_id])
  @@map("diagnostic_saves")
}

model DiagnosticReaction {
  id          String             @id @default(uuid())
  user_id     String
  target_id   String
  target_type ReactionTarget
  created_at  DateTime           @default(now())
  post_id     String?
  comment_id  String?
  comment     DiagnosticComment? @relation(fields: [comment_id], references: [id], onDelete: Cascade)
  post        DiagnosticPost?    @relation(fields: [post_id], references: [id], onDelete: Cascade)
  user        User               @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, post_id])
  @@unique([user_id, comment_id])
  @@unique([user_id, target_id, target_type])
  @@index([target_type, target_id])
  @@map("diagnostic_reactions")
}

model SubscriptionPlan {
  id            String             @id @default(uuid())
  name          String
  description   String?
  price_dzd     Decimal            @db.Decimal(10, 2)
  billing_cycle BillingCycle
  duration_days Int
  target_type   SubscriptionTarget
  features      Json?
  is_free_trial Boolean            @default(false)
  trial_days    Int?
  is_active     Boolean            @default(true)
  created_at    DateTime           @default(now())
  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id                     String             @id @default(uuid())
  subscriber_id          String
  subscriber_type        SubscriptionTarget
  plan_id                String
  status                 SubscriptionStatus @default(active)
  is_trial               Boolean            @default(false)
  started_at             DateTime
  expires_at             DateTime
  auto_renew             Boolean            @default(true)
  cancelled_at           DateTime?
  expiry_warning_sent_at DateTime?
  expired_notified_at    DateTime?
  created_at             DateTime           @default(now())
  payment                Payment?
  plan                   SubscriptionPlan   @relation(fields: [plan_id], references: [id])

  @@index([subscriber_id, subscriber_type])
  @@index([status, expires_at])
  @@map("subscriptions")
}

model PlatformSetting {
  id                  String   @id @default(uuid())
  key                 String   @unique
  value               Json
  description         String?
  updated_by_admin_id String?
  updated_at          DateTime @default(now()) @updatedAt

  @@map("platform_settings")
}

enum UserRole {
  customer
  professional
  store
  admin
}

enum ProfileStatus {
  pending
  approved
  rejected
}



enum FuelType {
  petrol
  diesel
  electric
  hybrid
  lpg
}

enum SellerType {
  client
  store
}

enum PartCondition {
  new
  used
  refurbished
}

enum OrderDeliveryType {
  home_delivery
  store_pickup
}

enum OrderStatus {
  pending
  confirmed
  processing
  shipped
  delivered
  cancelled
  refunded
}

enum PaymentMethod {
  edahabia
  cash_on_delivery
}

enum PaymentStatus {
  pending
  success
  failed
  refunded
}

enum AppointmentStatus {
  pending
  confirmed
  in_progress
  completed
  cancelled
}

enum PostStatus {
  open
  resolved
  closed
}

enum ReactionTarget {
  post
  comment
}

enum MessageType {
  text
  image
  file
  system
}

enum BillingCycle {
  monthly
  quarterly
  annual
}

enum SubscriptionTarget {
  professional
  store
}

enum SubscriptionStatus {
  active
  cancelled
  expired
  suspended
}

enum ReviewTarget {
  store
  part
  professional
}

enum LoyaltyOperation {
  earn
  redeem
  expire
  admin_adjust
}

enum FavoriteTarget {
  store
  professional
  part
}

enum ReportTarget {
  store
  professional
  post
  comment
  user
  conversation
}

enum ReportReason {
  spam
  fraud
  inappropriate_content
  fake_parts
  no_show
  other
}

enum ReportStatus {
  pending
  reviewed
  dismissed
  actioned
}

enum NotificationType {
  order_status_updated
  appointment_requested
  appointment_confirmed
  appointment_cancelled
  appointment_completed
  new_message
  subscription_expiring
  subscription_expired
  account_frozen
  account_unfrozen
  review_received
  report_reviewed
  professional_approved
  professional_rejected
  store_approved
  store_rejected
  loyalty_points_earned
  diagnostic_post_answered
  diagnostic_answer_accepted
  new_store_registration
  new_professional_registration
}

model PendingRegistration {
  id              String   @id @default(uuid())
  email           String   @unique
  password_hash   String
  phone           String?
  role            String   // "customer", "store", "professional"
  registration_data Json   // All profile-specific fields (full_name, store_name, etc.)
  file_urls       Json?    // Uploaded file URLs (documents, images, logos)
  otp_hash        String
  otp_expires_at  DateTime
  otp_last_sent_at DateTime?
  otp_attempts    Int      @default(0)
  created_at      DateTime @default(now())

  @@map("pending_registrations")
}

model Conversation {
  id                 String    @id @default(uuid())
  participant_one_id String
  participant_two_id String
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  participant_one    User      @relation("ParticipantOne", fields: [participant_one_id], references: [id], onDelete: Cascade)
  participant_two    User      @relation("ParticipantTwo", fields: [participant_two_id], references: [id], onDelete: Cascade)
  messages           Message[]
  reports            Report[]

  @@unique([participant_one_id, participant_two_id])
  @@index([participant_one_id])
  @@index([participant_two_id])
  @@index([updated_at])
  @@map("conversations")
}

model Message {
  id              String      @id @default(uuid())
  conversation_id String
  sender_id       String
  message_type    MessageType @default(text)
  content         String      @db.Text
  is_read         Boolean     @default(false)
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt

  conversation    Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  sender          User         @relation("SentMessages", fields: [sender_id], references: [id], onDelete: Cascade)

  @@index([conversation_id, created_at])
  @@index([sender_id])
  @@map("messages")
}
