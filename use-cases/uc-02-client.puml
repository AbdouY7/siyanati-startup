@startuml
' ──────────────────────────────────────────────────────────────────────────
'  SIYANATI — Diagramme de Cas d'Utilisation — CLIENT (Customer)
' ──────────────────────────────────────────────────────────────────────────
skinparam dpi 200
skinparam usecase {
  BackgroundColor #BBDEFB
  BorderColor #1565C0
  FontSize 12
  Padding 6
}
skinparam actor {
  BorderColor #37474F
  FontSize 13
  FontStyle bold
}
skinparam rectangle {
  BorderColor #1565C0
  FontSize 14
  FontStyle bold
  RoundCorner 12
  BackgroundColor #FAFAFA
}
skinparam ArrowThickness 1.5

left to right direction

actor "Client\n(Customer)" as Customer
actor "Edahabia\n(Paiement)" as PayGW #LightCoral

rectangle "Plateforme SIYANATI — Client" {
  usecase "Gérer Profil" as C01
